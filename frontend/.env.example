# Frontend configuration. Copy this file to frontend/.env and edit the values:
#     cp frontend/.env.example frontend/.env
# frontend/.env is gitignored. Every variable below is required; src/config.js
# validates them all when the app starts and shows what is missing.
#
# WARNING: Vite copies every VITE_* value into the JavaScript it serves, so
# anyone visiting the site can read them. NEVER put secrets (API keys,
# passwords, tokens) here. Secrets belong in backend/.env.
# Restart `npm run dev` after editing this file.

# Where the AppView API lives. Empty = same origin as the page ("/api/...").
# Can also be a path prefix ("/backend") or a full URL ("http://127.0.0.1:8000").
VITE_API_BASE_URL=

# AT Protocol services used to log in: the DID directory, and the servers
# that turn a handle (alice.bsky.social) into a DID, tried in order.
VITE_ATPROTO_PLC_DIRECTORY_URL=https://plc.directory
VITE_ATPROTO_HANDLE_RESOLVER_URLS=https://public.api.bsky.app,https://bsky.social

# Leaflet map library (point these at self-hosted copies to avoid the CDN).
VITE_LEAFLET_JS_URL=https://unpkg.com/leaflet@1.9.4/dist/leaflet.js
VITE_LEAFLET_CSS_URL=https://unpkg.com/leaflet@1.9.4/dist/leaflet.css

# Map tiles. The attribution is HTML required by the tile provider; change both
# together when switching providers (e.g. to Overture / Protomaps).
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
VITE_MAP_MAX_ZOOM=19

# Where the map starts (UC San Diego) and how far it is zoomed in.
VITE_MAP_CENTER_LAT=32.8801
VITE_MAP_CENTER_LNG=-117.234
VITE_MAP_DEFAULT_ZOOM=15

# --- Demo mode only (pages opened with ?mock; ignored otherwise) -------------
# Fake tokens the in-browser mock PDS (src/stubs/mockPds.js) hands out at
# login. Each token is the prefix followed by the user's DID. They unlock
# nothing real. Use letters, digits and ._~- only; the two must differ.
VITE_MOCK_PDS_ACCESS_TOKEN_PREFIX=mock-access-
VITE_MOCK_PDS_REFRESH_TOKEN_PREFIX=mock-refresh-

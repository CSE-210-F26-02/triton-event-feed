# Backend configuration. Copy this file to backend/.env and edit the values:
#     cp backend/.env.example backend/.env
# backend/.env is gitignored; never commit it. Real environment variables
# (e.g. set by a hosting provider) take priority over this file.
# Every variable below is required; backend/config.py validates them all at
# startup and lists anything missing or malformed.

# "true" in production, "false" for local development.
IS_PROD=false

# Production only: the site allowed to call the API (CORS), e.g.
# https://events.example.edu. Comma-separate several origins. "*" is refused.
PRODUCTION_SITE_URL=http://localhost:3000

# Development only: origins allowed to call the API. "*" allows any origin;
# or list them, e.g. http://localhost:5173,http://127.0.0.1:5173
DEV_CORS_ORIGINS=*

# Interface and port uvicorn listens on when running `python -m backend.main`.
API_HOST=127.0.0.1
API_PORT=8000

# CRITICAL, ERROR, WARNING, INFO or DEBUG.
LOG_LEVEL=INFO

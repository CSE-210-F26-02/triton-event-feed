# Backend configuration. Copy this file to backend/.env and edit the values:
#     cp backend/.env.example backend/.env
# backend/.env is gitignored; never commit it. Real environment variables
# (e.g. set by a hosting provider) take priority over this file.
# backend/config.py validates every variable at startup and lists anything
# missing or malformed.

# ---- Required ---------------------------------------------------------------

# "true" in production, "false" for local development.
IS_PROD=false

# Production only: other sites allowed to call the API (CORS), e.g.
# https://events.example.edu. Comma-separate several origins. "*" is refused.
# Leave it empty to allow only pages served by this backend (same origin).
PRODUCTION_SITE_URL=http://localhost:3000

# Development only: origins allowed to call the API. "*" allows any origin;
# or list them, e.g. http://localhost:5173,http://127.0.0.1:5173
DEV_CORS_ORIGINS=*

# Interface and port uvicorn listens on when running `python main.py`.
API_HOST=127.0.0.1
API_PORT=8000

# CRITICAL, ERROR, WARNING, INFO or DEBUG.
LOG_LEVEL=INFO

# SQLite database file (relative paths are relative to where the server is
# started, normally backend/). The folder is created if it does not exist.
DATABASE_PATH=data/communitymap.db

# The built frontend served at "/": run `npm run build` in frontend/ first.
# Not the frontend/ source folder itself; the server refuses to serve that.
FRONTEND_DIR=../frontend/dist

# "true" turns on demo mode: POST /api/dev/records lets you post events
# without a Bluesky account. Keep "false" for real deployments.
DEV_MODE=false

# "true" indexes real records from the AT Protocol network via Jetstream.
JETSTREAM_ENABLED=false

# ---- Optional (the value shown is the default) -----------------------------

# Jetstream WebSocket endpoint (ws:// or wss://).
# JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# Comma-separated iCal feed URLs polled in the background (default: none).
# ICAL_FEED_URLS=https://calendar.example.edu/events.ics

# Seconds between iCal polling rounds (at least 1).
# ICAL_INTERVAL_SECONDS=900

# Seconds between expiry sweeps (at least 1).
# EXPIRY_INTERVAL_SECONDS=60

# Seconds an event stays visible after it ends.
# EXPIRY_GRACE_SECONDS=0

# Days an expired event is kept before it is deleted from the index.
# EXPIRY_PURGE_DAYS=7
